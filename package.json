{
  "name": "sentrydiscord",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "tsc --noEmit",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "db:create": "npm run db:deploy && prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^4.8.0",
    "@tailwindcss/forms": "^0.5.3",
    "discord.js": "^14.7.1",
    "fathom-client": "^3.5.0",
    "next": "^13.1.1",
    "next-connect": "^0.13.0",
    "prisma": "^4.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.2.4"
  },
  "devDependencies": {
    "@types/react": "18.0.26",
    "autoprefixer": "^10.4.13",
    "postcss": "^8.4.20",
    "typescript": "~5.4.5"
  }
}
